# Copy to %USERPROFILE%\.autoapply\secrets.env. Never commit the real file.
ANTHROPIC_API_KEY=
# fine-grained token, only your job-monitor fork, Contents: read and write
GITHUB_TOKEN=
DISCORD_WEBHOOK_URL=
# one login for all your Workday accounts (`autoapply workday login` sets these)
WORKDAY_EMAIL=
WORKDAY_PASSWORD=
# Gmail app password for reading codes and Workday emails (`autoapply mail login`)
MAIL_ADDRESS=
MAIL_APP_PASSWORD=
